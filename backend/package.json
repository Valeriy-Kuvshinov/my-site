		"passport-jwt": "^4.0.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.2.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.11",
