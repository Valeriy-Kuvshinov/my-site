		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.3.2",
		"@nestjs/jwt": "^12.0.3",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.3.2",
		"@nestjs/schedule": "^12.0.2",
		"@nestjs/throttler": "^6.7.1",
		"bcrypt": "^6.0.0",
		"cache-manager": "^7.2.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.3.0",
