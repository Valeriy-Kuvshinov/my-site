{
	"name": "frontend",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"dev:ru": "ng serve --configuration=ru",
		"dev:he": "ng serve --configuration=he",
		"locales": "npx ng extract-i18n --output-path src/locale && node scripts/extract-i18n.mjs",
		"locales:inject": "node scripts/inject-i18n.mjs ru && node scripts/inject-i18n.mjs he",
		"build": "node scripts/generate-sitemap.mjs && ng build && rm -rf ../backend/out && mv dist/frontend/browser ../backend/out",
		"watch": "node scripts/generate-sitemap.mjs && ng build --watch --configuration development",
		"test": "ng test"
	},
	"private": true,
	"engines": {
		"node": ">=24.22.1"
	},
	"dependencies": {
		"@angular/animations": "^22.2.4",
		"@angular/common": "^22.2.4",
		"@angular/compiler": "^22.2.4",
		"@angular/core": "^22.2.4",
		"@angular/forms": "^22.2.4",
		"@angular/localize": "^22.2.4",
		"@angular/platform-browser": "^22.2.4",
		"@angular/platform-server": "^22.2.4",
		"@angular/router": "^22.2.4",
		"@angular/ssr": "^22.2.5",
		"@ngrx/signals": "^22.0.1",
		"express": "^5.3.0",
		"ngx-turnstile": "^1.0.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.9.1"
	},
	"devDependencies": {
		"@angular/build": "^22.2.5",
		"@angular/cli": "^22.2.5",
		"@angular/compiler-cli": "^22.2.4",
		"@tailwindcss/postcss": "^4.3.4",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"jsdom": "^30.1.3",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.4",
		"typescript": "~6.0.2",
		"vitest": "^5.1.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.2": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.6": true
	}
}
